** ------------------------------------------------------------------------
** Large-strain sweep: same model as ../dogbone_neohooke.inp (compressible
** NeoHooke, 3D one-layer hex mesh), but the right grip is ramped from 0 to
** 285 mm (= 300% nominal engineering strain on the 95 mm grip-to-grip free
** length) over many small increments, so that the per-increment monitor
** output traces out a continuous curve of gauge-section behaviour from the
** small-strain regime all the way to 300% nominal strain.
**
** nominal strain := (U_gripRight - U_gripLeft) / 95.0   [95 mm free length]
**
** This is purely a monitoring/curve-extraction run; see
** dogbone_neohooke_milestone_*.inp for full-field snapshots at specific
** strain levels used for the report's contour plots.
** ------------------------------------------------------------------------

*include, input=../../meshes/dogbone_mesh_3d.inp

*material, name=COMPRESSIBLENEOHOOKE, id=rubber
** K [MPa], G [MPa]
175000.0, 80769.2

*section, name=section1, material=rubber, type=solid
all

*job, name=dogboneNeoHookeSweepJob, domain=3d
*solver, solver=NIST, name=theSolver
linsolver=pardiso

*fieldOutput
>>perNode, nSet=gripClampLeft, field=displacement, result=U, name=U_gripLeft
>>perNode, nSet=gripClampRight, field=displacement, result=U, name=U_gripRight
>>perNode, nSet=gaugeLeftEdge, field=displacement, result=U, name=U_gaugeLeft
>>perNode, nSet=gaugeRightEdge, field=displacement, result=U, name=U_gaugeRight

*output, type=monitor
fieldOutput=U_gripLeft, f(x)='mean(x[:,0])'
*output, type=monitor
fieldOutput=U_gripRight, f(x)='mean(x[:,0])'
*output, type=monitor
fieldOutput=U_gaugeLeft, f(x)='mean(x[:,0])'
*output, type=monitor
fieldOutput=U_gaugeRight, f(x)='mean(x[:,0])'

*step, solver=theSolver
maxInc=0.01, minInc=1e-7, maxNumInc=2000, maxIter=40, criticalIter=8, stepLength=1.0
>>dirichlet, name=gripLeft,  nSet=gripClampLeft,  field=displacement, 1=0.0,   2=0.0
>>dirichlet, name=gripRight, nSet=gripClampRight, field=displacement, 1=285.0, 2=0.0
>>dirichlet, name=z0,        nSet=z0Layer,        field=displacement, 3=0.0
