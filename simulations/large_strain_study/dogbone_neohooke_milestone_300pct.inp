** ------------------------------------------------------------------------
** Full-field snapshot at 300% nominal engineering strain (285.0 mm grip
** displacement = 300% of the 95 mm free length), for the large-strain
** report's contour plots. See dogbone_neohooke_sweep_300pct.inp for the
** continuous 0->300% monitoring run this complements.
** ------------------------------------------------------------------------

*include, input=../../meshes/dogbone_mesh_3d.inp

*material, name=COMPRESSIBLENEOHOOKE, id=rubber
1166666.7, 71428.6

*section, name=section1, material=rubber, type=solid
all

*job, name=dogboneNeoHookeMilestone300, domain=3d
*solver, solver=NIST, name=theSolver
linsolver=pardiso

*fieldOutput
>>perNode, nSet=all, field=displacement, result=U, name=displacement
>>perElement, elSet=all, result=stress, name=stress, quadraturePoint=0:8, f(x)='np.mean(x,axis=1)'

*output, type=ensight, name=esExport300
>>configuration, overwrite=yes
>>perNode, fieldOutput=displacement
>>perElement, fieldOutput=stress

*step, solver=theSolver
maxInc=0.02, minInc=1e-7, maxNumInc=1000, maxIter=40, criticalIter=8, stepLength=1.0
>>dirichlet, name=gripLeft,  nSet=gripClampLeft,  field=displacement, 1=0.0,   2=0.0
>>dirichlet, name=gripRight, nSet=gripClampRight, field=displacement, 1=285.0, 2=0.0
>>dirichlet, name=z0,        nSet=z0Layer,        field=displacement, 3=0.0
